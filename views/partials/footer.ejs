<!--
  Partial footer -- PointGo-style dark footer (1 Sep 2026)
  Include lewat include('../partials/footer').
  Variabel yang dipakai: settings
-->
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <div class="footer-brand">
        <img src="<%= settings?.logoUrl || '/uploads/logo-main.png' %>" alt="<%= settings?.siteName || 'FranzzStore' %>" style="height:26px;">
      </div>
      <p class="footer-desc"><%= settings?.about || 'FranzzStore adalah platform topup game & premium app terpercaya #1 di Indonesia. Proses instan, aman, dan harga termurah.' %></p>
      <div class="footer-social">
        <a href="#" aria-label="Instagram"><iconify-icon icon="mdi:instagram"></iconify-icon></a>
        <a href="<%= settings?.contact?.whatsapp ? 'https://wa.me/' + settings.contact.whatsapp : '#' %>" aria-label="WhatsApp"><iconify-icon icon="mdi:whatsapp"></iconify-icon></a>
        <a href="#" aria-label="TikTok"><iconify-icon icon="ic:baseline-tiktok"></iconify-icon></a>
        <a href="#" aria-label="YouTube"><iconify-icon icon="mdi:youtube"></iconify-icon></a>
      </div>
    </div>
    <div>
      <h4>HALAMAN</h4>
      <a href="/">Halaman Utama</a>
      <a href="/cek-pesanan">Cek Pesanan</a>
      <a href="/riwayat">Riwayat Transaksi</a>
    </div>
    <div>
      <h4>MEMBER</h4>
      <a href="/register">Daftar Member</a>
      <a href="/login">Login Member</a>
      <a href="/dashboard">Dashboard</a>
    </div>
    <div>
      <h4>INFORMASI</h4>
      <a href="/informasi">Syarat &amp; Ketentuan</a>
      <a href="mailto:<%= settings?.contact?.email || 'support@franzzstore.id' %>"><%= settings?.contact?.email || 'support@franzzstore.id' %></a>
      <% if (settings?.contact?.whatsapp) { %><a href="https://wa.me/<%= settings.contact.whatsapp %>">WhatsApp CS</a><% } %>
    </div>
  </div>

  <div class="footer-payment">
    <h4 style="margin-bottom:0;">PEMBAYARAN TERJAMIN</h4>
    <div class="footer-payment-grid">
      <img src="/uploads/payments/qris.png" alt="QRIS">
      <img src="/uploads/payments/gopay.png" alt="GoPay">
      <img src="/uploads/payments/dana.png" alt="DANA">
      <img src="/uploads/payments/ovo.png" alt="OVO">
      <img src="/uploads/payments/shopeepay.png" alt="ShopeePay">
      <img src="/uploads/payments/bank-transfer.png" alt="Transfer Bank">
    </div>
  </div>

  <div class="footer-bottom">
    &copy; <%= new Date().getFullYear() %> <%= settings?.siteName || 'FranzzStore' %>. All Rights Reserved.
  </div>
</footer>
