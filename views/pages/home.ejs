
<%
const pageTitle = 'Beranda';
%>

<!-- NAVBAR -->
<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all" style="background:rgba(5,7,11,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between" style="height:56px;">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-2 flex-shrink-0" style="text-decoration:none;">
                <% if (settings?.logoUrl) { %>
                <img src="<%= settings.logoUrl || '/uploads/logo-franzzstore.png' %>" alt="Logo FranzzStore" class="w-auto object-contain flex-shrink-0" style="height:44px;" onerror="this.onerror=null;this.src='/uploads/logo-franzzstore.png';">
                <% } else { %>
                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:var(--blue);">
                    <iconify-icon icon="mdi:store" style="color:#fff;font-size:18px;"></iconify-icon>
                </div>
                <% } %>
                <span style="font-family:'Orbitron',sans-serif;font-weight:900;font-size:14px;color:#ffffff;letter-spacing:.03em;line-height:1;"><%= settings?.siteName || 'FRANZZSTORE' %></span>
            </a>

            <!-- Search matches PointGo desktop header and remains compact on mobile -->
            <label class="pointgo-home-search hidden sm:flex" aria-label="Cari game atau voucher">
                <iconify-icon icon="mdi:magnify"></iconify-icon>
                <input type="search" placeholder="Cari game atau voucher disini...">
            </label>

            <!-- Desktop links -->
            <div class="hidden md:flex items-center gap-1">
                <a href="/invoice" class="px-3 py-1.5 rounded-lg text-sm transition-colors" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)';this.style.background='rgba(255,255,255,.05)'" onmouseout="this.style.color='var(--text-2)';this.style.background='transparent'">Cek Pesanan</a>
                <% if (isAdmin) { %>
                <a href="/admin" class="px-3 py-1.5 rounded-lg text-sm font-semibold" style="color:#fb923c;">Admin</a>
                <% } %>
                <% if (user) { %>
                <a href="/dashboard" class="px-3 py-1.5 rounded-lg text-sm transition-colors" style="color:var(--text-2);" onmouseover="this.style.color='var(--text-1)'" onmouseout="this.style.color='var(--text-2)'">Dashboard</a>
                <% } else { %>
                <a href="/login" class="btn btn-outline text-sm px-3 py-1.5">Masuk</a>
                <% } %>
            </div>

            <!-- Right actions -->
            <div class="flex items-center gap-2">
                <button onclick="openCart()" class="relative w-9 h-9 rounded-lg flex items-center justify-center transition-colors" style="background:rgba(255,255,255,.05);border:1px solid var(--border);">
                    <iconify-icon icon="mdi:cart-outline" style="color:var(--text-2);font-size:18px;"></iconify-icon>
                    <span id="cart-badge" class="absolute -top-1 -right-1 min-w-[16px] h-4 rounded-full text-[9px] font-black text-white items-center justify-center px-1" style="background:var(--red);display:none;"></span>
                </button>
                <button onclick="openMenu()" aria-label="Buka menu" aria-expanded="false" class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors" style="background:rgba(255,255,255,.05);border:1px solid var(--border);">
                    <iconify-icon icon="mdi:menu" style="color:var(--text-2);font-size:18px;"></iconify-icon>
                </button>
            </div>
        </div>
    </div>
</nav>

<!-- HERO BANNER CAROUSEL -->
<section id="home" class="pt-14">
    <!-- Banner full-width, tidak ada px agar menempel navbar -->
    <div id="carousel-wrap" class="relative overflow-hidden select-none"
         style="height:clamp(168px,35vw,260px);background:#05070B;border-bottom:1px solid rgba(19,216,255,.2);box-shadow:0 8px 40px rgba(19,216,255,.12);">

        <div id="carousel-skeleton"></div>

        <div id="carousel-track" class="flex h-full" style="transition:transform .52s cubic-bezier(.4,0,.2,1);will-change:transform;">

            <!-- DEFAULT SLIDE -->
            <div class="c-slide flex-shrink-0 relative" id="c-slide-default"
                 style="background:linear-gradient(135deg,#05070B 0%,#130929 55%,#05070B 100%);">
                <img class="c-img" src="/uploads/banners/banner-1.jpg" alt="Promo FranzzStore" loading="eager">
                <div class="c-overlay"></div>
                <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 70% 60% at 15% 50%,rgba(19,216,255,.22) 0%,transparent 70%);animation:bannerPulse 4s ease-in-out infinite;z-index:1;"></div>
                <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 50% 80% at 85% 50%,rgba(19,216,255,.12) 0%,transparent 70%);animation:bannerPulse 4s 2s ease-in-out infinite;z-index:1;"></div>
                <div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,.04) 3px,rgba(0,0,0,.04) 4px);z-index:2;"></div>
                <div class="relative z-10 h-full flex flex-col justify-center px-5 sm:px-10 max-w-2xl">

                </div>
            </div>
            <!-- admin slides injected by JS -->
        </div>

        <!-- Dots selalu tampil minimal 1 -->
        <div id="carousel-dots" class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-20">
            <div class="c-dot active"></div>
        </div>
    </div>

</section>

<style>
@keyframes bannerPulse{0%,100%{opacity:.6;transform:scale(1);}50%{opacity:1;transform:scale(1.07);}}
@keyframes slideUpIn{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
@keyframes dotShimmer{0%{background-position:0% 50%;}100%{background-position:200% 50%;}}
@keyframes shimmerSweep{0%{background-position:-400px 0;}100%{background-position:400px 0;}}

/* Aksen diagonal stripes ala pointgo.id, warna biru sesuai brand Franzzstore */
#carousel-wrap::before{
    content:'';position:absolute;inset:0;z-index:0;pointer-events:none;
    background:repeating-linear-gradient(-45deg,rgba(19,216,255,.05) 0px,rgba(19,216,255,.05) 2px,transparent 2px,transparent 26px);
    mix-blend-mode:screen;
}

/* Skeleton loading shimmer, tampil sebelum /api/banners selesai fetch */
#carousel-skeleton{
    position:absolute;inset:0;z-index:5;
    background:linear-gradient(90deg,#1b2027 0%,#262c35 20%,#1b2027 40%,#1b2027 100%);
    background-size:800px 100%;
    animation:shimmerSweep 1.4s linear infinite;
}

#carousel-track .c-slide{flex:0 0 100%;width:100%;height:100%;position:relative;overflow:hidden;}
#popular-track::-webkit-scrollbar{display:none;}
.glow-first{animation:firstGlowAura 2s ease-in-out infinite;border:3px solid rgba(255,255,255,0.7)!important;}
@keyframes firstGlowAura{0%,100%{box-shadow:0 0 20px rgba(251,191,36,0.6),0 0 40px rgba(19,216,255,0.4),inset 0 0 10px rgba(255,255,255,0.3)}50%{box-shadow:0 0 40px rgba(251,191,36,0.9),0 0 80px rgba(19,216,255,0.7),inset 0 0 20px rgba(255,255,255,0.6)}}
#carousel-track .c-slide>img.c-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
#carousel-track .c-slide .c-overlay{position:absolute;inset:0;z-index:1;background:linear-gradient(105deg,rgba(0,0,0,.82) 0%,rgba(0,0,0,.45) 45%,rgba(0,0,0,.08) 100%);}
#carousel-track .c-slide .c-body{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;justify-content:center;padding:clamp(14px,4vw,32px) clamp(16px,6vw,48px);max-width:65%;}
#carousel-track .c-slide .c-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:9px;font-weight:800;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;width:fit-content;background:rgba(19,216,255,.22);border:1px solid rgba(19,216,255,.5);color:#78FFFF;}
#carousel-track .c-slide .c-title{font-family:'Orbitron',sans-serif;font-weight:900;font-size:clamp(14px,3.5vw,30px);color:#fff;line-height:1.15;text-shadow:0 2px 20px rgba(0,0,0,.8);}
#carousel-track .c-slide .c-sub{font-size:clamp(9px,1.6vw,13px);color:rgba(255,255,255,.72);margin-top:5px;line-height:1.4;text-shadow:0 1px 8px rgba(0,0,0,.5);}
#carousel-track .c-slide .c-cta{display:inline-flex;align-items:center;gap:5px;margin-top:10px;padding:7px 16px;border-radius:10px;font-size:10px;font-weight:800;background:linear-gradient(135deg,#13D8FF,#66F5FF);color:#fff;border:none;cursor:pointer;transition:all .2s;width:fit-content;box-shadow:0 4px 14px rgba(19,216,255,.4);}
#carousel-track .c-slide .c-cta:hover{transform:translateY(-1px);box-shadow:0 6px 24px rgba(19,216,255,.6);}

.c-dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.32);transition:all .38s cubic-bezier(.4,0,.2,1);cursor:pointer;flex-shrink:0;}
.c-dot.active{width:26px;border-radius:4px;background:linear-gradient(90deg,#4CF5FF,#78FFFF,#4CF5FF);background-size:200% 100%;animation:dotShimmer 1.6s linear infinite;box-shadow:0 0 10px rgba(76,245,255,.7);}
.c-dot:hover:not(.active){background:rgba(255,255,255,.55);}

.game-card .card-img-wrap{overflow:hidden;}
.game-card .card-img-wrap img,.game-card .card-img-wrap .card-img-placeholder{transition:transform .35s cubic-bezier(.4,0,.2,1);}
.game-card:hover .card-img-wrap img,.game-card:hover .card-img-wrap .card-img-placeholder{transform:scale(1.1);}
.game-card:active .card-img-wrap img,.game-card:active .card-img-wrap .card-img-placeholder{transform:scale(1.18);transition:transform .15s ease-out;}

@media(max-width:640px){#carousel-track .c-slide .c-body{max-width:82%;}}
</style>

<script>
(function(){
    let slides=[], cur=0, total=1, timer=null;
    const INTERVAL=4200;

    async function initCarousel(){
        try{ const r=await fetch('/api/banners'); slides=await r.json(); }catch{ slides=[]; }

        document.getElementById('carousel-skeleton')?.remove();

        const track=document.getElementById('carousel-track');
        const dotsEl=document.getElementById('carousel-dots');
        const prevBtn=document.getElementById('carousel-prev');
        const nextBtn=document.getElementById('carousel-next');

        if(!slides.length){ total=1; return; }

        document.getElementById('c-slide-default')?.remove();

        track.innerHTML=slides.map((s,i)=>{
            const hl=s.link&&s.link!=='/';
            return `<div class="c-slide"${hl?` onclick="window.location='${s.link}'" style="cursor:pointer"`:''}>
                <img class="c-img" src="${s.imageUrl}" alt="${s.title||''}" loading="${i===0?'eager':'lazy'}"
                     onerror="this.style.display='none';this.closest('.c-slide').style.background='#05070B'">
                <div class="c-overlay"></div>
                <div class="c-body" style="animation:slideUpIn .45s ease-out both;">
                    ${s.title||s.subtitle?`<div class="c-badge"><iconify-icon icon="mdi:lightning-bolt" style="font-size:8px;"></iconify-icon> PROMO</div>`:''}
                    ${s.title?`<div class="c-title">${s.title}</div>`:''}
                    ${s.subtitle?`<div class="c-sub">${s.subtitle}</div>`:''}
                    ${hl?`<div class="c-cta"><iconify-icon icon="mdi:arrow-right" style="font-size:11px;"></iconify-icon> Lihat Detail</div>`:''}
                </div>
            </div>`;
        }).join('');

        total=slides.length;
        dotsEl.innerHTML=slides.map((_,i)=>
            `<div class="c-dot${i===0?' active':''}" onclick="goSlide(${i})"></div>`
        ).join('');

        if(total>1){
            startAuto();
            addSwipe();
        }
        goSlide(0);
    }

    window.goSlide=function(idx){
        if(total<=1)return;
        cur=((idx%total)+total)%total;
        document.getElementById('carousel-track').style.transform=`translateX(-${cur*100}%)`;
        document.querySelectorAll('.c-dot').forEach((d,i)=>d.classList.toggle('active',i===cur));
    };
    window.carouselMove=function(dir){ goSlide(cur+dir); resetAuto(); };
    function startAuto(){ clearInterval(timer); timer=setInterval(()=>goSlide(cur+1),INTERVAL); }
    function resetAuto(){ clearInterval(timer); startAuto(); }
    function addSwipe(){
        const w=document.getElementById('carousel-wrap');
        w.addEventListener('mouseenter',()=>clearInterval(timer));
        w.addEventListener('mouseleave',()=>startAuto());
        w.addEventListener('touchstart',e=>{ clearInterval(timer); w.dataset.tx=e.touches[0].clientX; },{passive:true});
        w.addEventListener('touchend',e=>{
            const dx=e.changedTouches[0].clientX-(parseFloat(w.dataset.tx)||0);
            if(Math.abs(dx)>38)goSlide(cur+(dx<0?1:-1));
            startAuto();
        },{passive:true});
    }

    document.addEventListener('DOMContentLoaded',initCarousel);
})();
</script>

<!-- PRODUK POPULER CAROUSEL -->
<section id="popular-products" class="relative py-10 sm:py-16" style="display:none !important;">
    <div class="absolute top-0 right-0 w-[300px] h-[300px] bg-blue-700/[0.03] rounded-full blur-[100px] pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-3 sm:px-6">
        <div class="mb-5 sm:mb-6">
            <h2 class="font-display text-base sm:text-xl font-bold mb-1 text-left flex items-center gap-2">
                <iconify-icon icon="solar:fire-bold" class="text-orange-400 text-lg sm:text-xl"></iconify-icon>Produk Populer
            </h2>
            <p class="text-white/25 text-[10px] sm:text-xs">Paling banyak terjual minggu ini</p>
        </div>
        <div class="popular-scroll-wrapper relative">
            <div id="popular-track" class="popular-scroll flex gap-3 overflow-x-auto pb-2"
                 style="-ms-overflow-style:none;scrollbar-width:none;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;">
                <!-- skeletons -->
                <div class="glass rounded-xl border border-white/[0.04] overflow-hidden animate-pulse flex-shrink-0" style="min-width:200px;max-width:200px;scroll-snap-align:start;">
                    <div class="h-28 bg-white/[0.03]"></div>
                    <div class="p-3 space-y-2"><div class="h-3 bg-white/[0.04] rounded-lg w-4/5"></div><div class="h-2.5 bg-white/[0.03] rounded-lg w-3/5"></div><div class="h-8 bg-white/[0.04] rounded-xl mt-2"></div></div>
                </div>
                <div class="glass rounded-xl border border-white/[0.04] overflow-hidden animate-pulse flex-shrink-0" style="min-width:200px;max-width:200px;scroll-snap-align:start;animation-delay:.15s">
                    <div class="h-28 bg-white/[0.03]"></div>
                    <div class="p-3 space-y-2"><div class="h-3 bg-white/[0.04] rounded-lg w-4/5"></div><div class="h-2.5 bg-white/[0.03] rounded-lg w-3/5"></div><div class="h-8 bg-white/[0.04] rounded-xl mt-2"></div></div>
                </div>
                <div class="glass rounded-xl border border-white/[0.04] overflow-hidden animate-pulse flex-shrink-0" style="min-width:200px;max-width:200px;scroll-snap-align:start;animation-delay:.3s">
                    <div class="h-28 bg-white/[0.03]"></div>
                    <div class="p-3 space-y-2"><div class="h-3 bg-white/[0.04] rounded-lg w-4/5"></div><div class="h-2.5 bg-white/[0.03] rounded-lg w-3/5"></div><div class="h-8 bg-white/[0.04] rounded-xl mt-2"></div></div>
                </div>
            </div>
            <div class="absolute top-0 right-0 bottom-2 w-10 pointer-events-none" style="background:linear-gradient(to left,var(--bg-main),transparent);"></div>
        </div>
    </div>
</section>

<!-- FLASH DEALS: PointGo one-row horizontal strip -->
<section id="flash-deals" class="pointgo-flash-section">
    <div class="pointgo-section-shell">
        <div class="pointgo-flash-heading">
            <h2>FLASH DEAL</h2>
            <span class="pointgo-countdown"><iconify-icon icon="mdi:clock-outline"></iconify-icon> <time id="pointgo-countdown">00:14:55</time></span>
        </div>
        <div class="pointgo-flash-viewport">
            <div class="pointgo-flash-track">
                <% (products || []).slice(0, 12).forEach((product, i) => { const pricing = product.pricingOptions || product.items || []; const price = pricing.length ? Number(pricing[0].price ?? pricing[0].p ?? pricing[0]) : Number(product.price || 0); %>
                <a href="/buy/<%= product.id %>" class="pointgo-deal-card">
                    <div class="pointgo-deal-art">
                        <% if (product.imageUrl || product.image) { %><img src="<%= product.imageUrl || product.image %>" alt="<%= product.name %>"><% } else { %><iconify-icon icon="mdi:gamepad-variant"></iconify-icon><% } %>
                        <span class="pointgo-stock">Tersisa: <%= Math.max(1, 20 - i) %></span>
                        <del>Rp <%= (price * 1.25).toLocaleString('id-ID') %></del>
                    </div>
                    <div class="pointgo-deal-copy"><strong><%= product.name %></strong><b>Rp <%= price.toLocaleString('id-ID') %></b><em>FLASH DEAL</em></div>
                </a>
                <% }) %>
            </div>
        </div>
        <div class="pointgo-flash-dots" aria-label="Indikator Flash Deal"><i></i><i></i><i></i><i></i><i></i></div>
    </div>
</section>
<script>
(function(){
  const el=document.getElementById('pointgo-countdown'); if(!el) return;
  let remaining=14*60+55;
  const tick=()=>{ const m=Math.floor(remaining/60), s=remaining%60; el.textContent=`00:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`; if(remaining>0) remaining--; };
  tick(); setInterval(tick,1000);
  const track=document.querySelector('.pointgo-flash-track');
  if(track && !track.dataset.looped){ track.dataset.looped='true'; track.innerHTML += track.innerHTML; }
})();
</script>

<!-- PRODUCTS -->
<section id="games" class="relative py-10 sm:py-16 border-t border-white/[0.03]">
    <div class="relative max-w-7xl mx-auto px-3 sm:px-6">
        <div class="mb-5 sm:mb-8">
            <h2 class="font-display text-base sm:text-xl font-bold mb-1 text-left flex items-center gap-2">
                <iconify-icon icon="solar:widget-bold" class="text-blue-400 text-lg sm:text-xl"></iconify-icon>Semua Produk
            </h2>
            <p class="text-white/25 text-[10px] sm:text-xs">Filter berdasarkan game</p>
        </div>

        <% if (categories && categories.length > 0) { %>
        <div class="filter-scroll flex gap-2 mb-6 sm:mb-8 overflow-x-auto pb-1" style="-ms-overflow-style:none;scrollbar-width:none;">
            <div class="filter-sticky-left">
                <button onclick="filterProducts('all')" class="prod-filter px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl text-[11px] sm:text-xs font-semibold transition-all whitespace-nowrap bg-blue-600 text-white" data-pf="all">Semua</button>
            </div>
            <% categories.forEach(cat => { %>
                <button onclick="filterProducts('<%= cat %>')" class="prod-filter flex-shrink-0 px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl text-[11px] sm:text-xs font-semibold transition-all whitespace-nowrap bg-white/5 text-white/40 hover:text-white hover:bg-white/8" data-pf="<%= cat %>">
                    <%= categoryLabels[cat] || cat.toUpperCase() %>
                </button>
            <% }) %>
        </div>
        <% } %>

        <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-4">
            <% products.forEach((product, pIdx) => {
                const stock = product.keys ? product.keys.length : 0;
                const isOut = stock === 0;
                const isLow = stock > 0 && stock <= 5;
                const hasAndroid = product.platforms && product.platforms.includes('android');
                const hasIos = product.platforms && product.platforms.includes('ios');
                const displayStock = stock;
                const displaySold  = product.sold || 0;
                const pricingArr = product.pricingOptions || product.items || [];
                const priceList = pricingArr.map(x => (typeof x === 'object' ? (x.price ?? x.p) : x)).filter(v => typeof v === 'number');
                const minPrice = priceList.length ? Math.min(...priceList) : (product.price || 0);
                const soldLabel    = displaySold >= 1000 ? (displaySold/1000).toFixed(1).replace('.0','') + 'K' : String(displaySold);
                const badgeLabels = ['BEST','HOT','TOP','NEW','SALE'];
                const badgeColors = ['bg-red-500/80','bg-yellow-500/80 text-black','bg-blue-500/80','bg-emerald-500/80','bg-fuchsia-500/80'];
                const autoBadge = badgeLabels[pIdx % 5];
                const autoBadgeColor = badgeColors[pIdx % 5];
                const productBadge = product.badge || autoBadge;
                const productBadgeColor = product.badgeColor || autoBadgeColor;
            %>
                <div class="product-card glass rounded-xl sm:rounded-2xl overflow-hidden border border-white/[0.04]" data-category="<%= product.category %>">
                    <div class="relative overflow-hidden" style="height:110px;">
                        <% if (product.image) { %>
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover" loading="lazy"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                            <div class="absolute inset-0 items-center justify-center hidden" style="background:rgba(19,216,255,.06);">
                                <iconify-icon icon="solar:gamepad-bold" class="text-2xl text-blue-400/40"></iconify-icon>
                            </div>
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center" style="background:rgba(19,216,255,.06);">
                                <iconify-icon icon="solar:gamepad-bold" class="text-2xl text-blue-400/40"></iconify-icon>
                            </div>
                        <% } %>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent pointer-events-none"></div>
                        <% if (productBadge) { %>
                            <span class="badge-tag <%= productBadgeColor %> absolute top-1.5 left-1.5 z-10"><%= productBadge %></span>
                        <% } %>
                        <div class="absolute top-1.5 right-1.5 z-10">
                            <% if (hasAndroid) { %>
                                <span class="platform-label">ANDROID</span>
                            <% } else if (hasIos) { %>
                                <span class="platform-label">iOS</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="p-2 sm:p-3">
                        <h3 class="font-bold text-[10px] sm:text-xs truncate mb-1.5" style="color:var(--text-1);"><%= product.name %></h3>
                        <div class="flex justify-between items-center text-[9px] sm:text-[10px] mb-2">
                            <span class="font-bold" style="color:var(--blue);">Rp <%= minPrice.toLocaleString('id-ID') %></span>
                            <span class="text-white/30">Terjual <span class="text-white/50 font-bold"><%= soldLabel %></span></span>
                        </div>
                        <% if (!isOut) { %>
                            <a href="/buy/<%= product.id %>"
                               class="btn-primary w-full py-1.5 sm:py-2.5 rounded-lg sm:rounded-xl text-[9px] sm:text-xs font-bold text-white flex items-center justify-center gap-1">
                                <iconify-icon icon="solar:cart-large-2-bold" class="text-[9px] sm:text-sm"></iconify-icon>Beli
                            </a>
