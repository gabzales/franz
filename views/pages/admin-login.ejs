<%
const pageTitle = 'Admin Access';
const noIndex = true; // halaman admin, jangan di-index Google
%>
<!DOCTYPE html>
<html lang="id">
<head>
<%# DARK MODE: dipasang sinkron paling awal supaya tidak ada flash terang %>
<script>
  try {
    if (localStorage.getItem('fz-theme') === 'dark') {
      document.documentElement.classList.add('dark');
    }
  } catch (e) {}
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title><%= pageTitle %> — <%= settings?.siteName || 'FranzzStore' %></title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#080e14">
<link rel="icon" type="image/png" href="<%= settings?.logoUrl || '/uploads/logo-main.png' %>">
<link rel="apple-touch-icon" href="<%= settings?.logoUrl || '/uploads/logo-main.png' %>">
<link rel="stylesheet" href="/css/pointgo-theme.css">
<script>window.IconifyPreload = <%- iconBundle %>;</script>
<script src="/js/iconify-icon.min.js" defer></script>
<style>
  :root, html.dark {
    --bg: #080e14;
    --bg-soft: #0a1016;
    --panel: #18232d;
    --panel-soft: #121b24;
    --line: #35424c;
    --accent: #2F6FED;
    --accent-dim: #1d4ed8;
    --orange: #f08313;
    --text: #f4f6f8;
    --muted: #89939c;
    --red: #ff4d5e;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 18px;
  }
  body { background: var(--bg) !important; color: var(--text) !important; }
  /* Halaman admin login tampil sendiri (layout:false) tanpa navbar,
     jadi isi penuh viewport. */
  .auth-page { min-height: 100vh; }
  /* override --input untuk si slot form admin biar konsisten dark */
  .pg-input-wrap .pg-input { padding-left: 40px; }
  .auth-brand-login { color: var(--muted); }
</style>
</head>
<body class="font-inter">
<div class="auth-page">
    <!-- Sisi kiri: brand panel -->
    <div class="auth-art">
        <div style="position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px;text-align:center;">
            <div class="inline-flex items-center justify-center" style="width:72px;height:72px;border-radius:var(--radius-lg);background:rgba(47,111,237,.12);border:1px solid rgba(47,111,237,.3);margin-bottom:20px;">
                <iconify-icon icon="mdi:shield-crown" style="font-size:36px;color:var(--accent);"></iconify-icon>
            </div>
            <h1 style="color:#fff;font-size:24px;margin-bottom:10px;"><%= settings?.siteName || 'FranzzStore' %> Admin</h1>
            <p class="auth-brand-login" style="font-size:13px;max-width:300px;line-height:1.6;">Panel kontrol terenkripsi untuk pengelolaan toko. Akses dibatasi ketat.</p>
        </div>
    </div>

    <!-- Sisi kanan: form login -->
    <div class="auth-form-wrap">
        <div class="auth-form-card">
            <div class="auth-head">
                <div class="auth-logo">
                    <img src="<%= settings?.logoUrl || '/uploads/logo-main.png' %>" alt="<%= settings?.siteName || 'FranzzStore' %>" style="height:34px;width:34px;object-fit:contain;">
                    <b style="font-size:18px;font-weight:900;color:#fff;"><%= settings?.siteName || 'FranzzStore' %></b>
                </div>
                <h1 class="auth-title">Admin Panel</h1>
                <p class="auth-sub">Akses terbatas — hanya untuk administrator</p>
            </div>

            <% if (typeof notice !== 'undefined' && notice) { %>
            <div style="background:rgba(47,111,237,.1);border:1px solid rgba(47,111,237,.3);color:var(--text);border-radius:var(--radius-sm);padding:12px 14px;margin-bottom:16px;font-size:13px;display:flex;gap:8px;align-items:flex-start;">
                <iconify-icon icon="mdi:information-outline" style="flex-shrink:0;margin-top:2px;color:var(--accent);"></iconify-icon>
                <span><%= notice %></span>
            </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="pg-auth-error">
                <iconify-icon icon="mdi:alert-circle" style="flex-shrink:0;"></iconify-icon>
                <span><%= error %></span>
            </div>
            <% } %>

            <% if (typeof lockedInfo !== 'undefined' && lockedInfo) { %>
            <%# LANGKAH 2: password sudah benar, tinggal konfirmasi ambil alih (1 klik) %>
            <div style="background:rgba(240,131,19,.1);border:1px solid rgba(240,131,19,.3);border-radius:var(--radius-sm);padding:14px;margin-bottom:16px;font-size:13px;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                    <iconify-icon icon="mdi:check-circle" style="color:#34d399;flex-shrink:0;"></iconify-icon>
                    <span style="font-weight:700;color:var(--text);">Password benar</span>
                </div>
                <div style="color:var(--muted);line-height:1.6;">
                    Tapi panel admin sedang dipakai di
                    <b style="color:var(--text);"><%= lockedInfo.device %></b>
                    (aktif <%= lockedInfo.minutesAgo %> menit lalu). Hanya 1 perangkat yang boleh login admin sekaligus.
                </div>
            </div>
            <form method="POST" action="/vpr-secure-panel-8x/takeover" style="margin-bottom:10px;">
                <button type="submit" class="pg-btn pg-btn-primary pg-btn-block" style="width:100%;background:var(--accent);border:1px solid rgba(47,111,237,.5);color:#fff;">
                    <iconify-icon icon="mdi:swap-horizontal"></iconify-icon>
                    Ambil alih &amp; masuk (perangkat lain logout)
                </button>
            </form>
            <a href="/vpr-secure-panel-8x" style="display:block;text-align:center;font-size:13px;color:var(--muted);padding:8px;">Batal</a>

            <% } else { %>
            <form method="POST" action="/vpr-secure-panel-8x">
                <div class="pg-field">
                    <label class="pg-field-label" for="adm-user">Username Admin</label>
                    <div class="pg-input-wrap">
                        <iconify-icon icon="mdi:account-outline" class="pg-input-icon"></iconify-icon>
                        <input id="adm-user" type="text" name="username" placeholder="Username" value="<%= typeof username !== 'undefined' ? username : '' %>" class="pg-input" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required <%= (typeof username !== 'undefined' && username) ? '' : 'autofocus' %>>
                    </div>
                </div>
                <div class="pg-field">
                    <label class="pg-field-label" for="adm-pass">Password</label>
                    <div class="pg-input-wrap">
                        <iconify-icon icon="mdi:lock-outline" class="pg-input-icon"></iconify-icon>
                        <input id="adm-pass" type="password" name="password" placeholder="Password" class="pg-input" autocomplete="current-password" style="padding-right:44px;" required <%= (typeof username !== 'undefined' && username) ? 'autofocus' : '' %>>
                        <button type="button" id="adm-toggle" aria-label="Tampilkan password" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:0;color:var(--muted);cursor:pointer;padding:6px;font-size:18px;line-height:1;">
                            <iconify-icon icon="mdi:eye-outline"></iconify-icon>
                        </button>
                    </div>
                </div>

                <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
                <div class="pg-field">
                    <div style="border:1px solid var(--line);border-radius:8px;padding:8px;display:flex;justify-content:center;">
                        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark" data-size="flexible"></div>
                    </div>
                </div>
                <% } %>

                <button type="submit" class="pg-btn pg-btn-primary pg-btn-block" style="width:100%;background:var(--accent);border:1px solid rgba(47,111,237,.5);color:#fff;">
                    <iconify-icon icon="mdi:lock-open-outline"></iconify-icon>
                    Masuk ke Panel Admin
                </button>
            </form>
            <script>
              (function () {
                var b = document.getElementById('adm-toggle'), i = document.getElementById('adm-pass');
                if (!b || !i) return;
                b.addEventListener('click', function () {
                  var show = i.type === 'password';
                  i.type = show ? 'text' : 'password';
                  b.setAttribute('aria-label', show ? 'Sembunyikan password' : 'Tampilkan password');
                  b.firstElementChild.setAttribute('icon', show ? 'mdi:eye-off-outline' : 'mdi:eye-outline');
                });
              })();
            </script>
            <% } %>

            <div class="pg-auth-links">
                <a href="/">
                    <iconify-icon icon="mdi:arrow-left" style="vertical-align:-2px;"></iconify-icon> Kembali ke Beranda
                </a>
            </div>
        </div>
    </div>
</div>
<% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% } %>
</body>
</html>
