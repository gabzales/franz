<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= gameFilter ? `Jual Beli Akun ${gameFilter}` : 'Jual Beli Akun' %> — <%= settings?.siteName || 'FranzzStore' %></title>
  <link rel="icon" type="image/png" href="<%= settings?.logoUrl || '/uploads/logo-main.png' %>">
  <link rel="stylesheet" href="/css/pointgo-theme.css">
  <script>window.IconifyPreload = <%- iconBundle %>;</script>
  <script src="/js/iconify-icon.min.js" defer></script>
  <style>
    .akun-hero { padding: 20px 16px 6px; max-width: 1180px; margin: 0 auto; }
    .akun-hero h1 { font-size: 20px; font-weight: 900; color: #fff; }
    .akun-hero p { font-size: 12.5px; color: var(--muted); margin-top: 4px; }
    .akun-game-tabs { display: flex; gap: 8px; overflow-x: auto; padding: 14px 16px; max-width: 1180px; margin: 0 auto; -ms-overflow-style: none; scrollbar-width: none; }
    .akun-game-tabs::-webkit-scrollbar { display: none; }
    .akun-game-tabs a { flex-shrink: 0; padding: 8px 16px; border-radius: 999px; font-size: 12px; font-weight: 700; text-decoration: none; background: var(--panel); color: var(--muted); border: 1px solid var(--line); }
    .akun-game-tabs a.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .akun-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 6px 16px 50px; max-width: 1180px; margin: 0 auto; }
    @media (min-width: 640px) { .akun-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 900px) { .akun-grid { grid-template-columns: repeat(4, 1fr); } }
    .akun-card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; text-decoration: none; display: block; transition: transform .15s ease; }
    .akun-card:active { transform: scale(0.97); }
    .akun-card-img { aspect-ratio: 4/3; overflow: hidden; background: var(--bg-soft); }
    .akun-card-img img { width: 100%; height: 100%; object-fit: cover; }
    .akun-card-body { padding: 10px; }
    .akun-card-game { font-size: 9.5px; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: .04em; }
    .akun-card-title { font-size: 12.5px; font-weight: 700; color: #fff; margin-top: 4px; line-height: 1.3; min-height: 2.4em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .akun-card-price { font-size: 13.5px; font-weight: 900; color: #8EF9FF; margin-top: 6px; }
    .akun-empty { text-align: center; padding: 60px 20px; color: var(--muted); }
    .akun-jual-fab { position: fixed; right: 16px; bottom: 24px; z-index: 20; display: flex; align-items: center; gap: 8px; padding: 13px 20px; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 800; font-size: 13px; text-decoration: none; box-shadow: 0 8px 24px rgba(47,111,237,.5); }
  </style>
</head>
<body>

<%- include('../partials/navbar', { active: 'home' }) %>

<div class="akun-hero">
  <h1>Jual Beli Akun<% if (gameFilter) { %> <%= gameFilter %><% } %></h1>
  <p>Cari akun impianmu atau jual akun gamemu — aman &amp; sudah diverifikasi admin.</p>
</div>

<div class="akun-game-tabs">
  <a href="/jual-beli-akun" class="<%= !gameFilter ? 'active' : '' %>">Semua</a>
  <% allCategories.forEach(function(cat) { %>
  <a href="/jual-beli-akun?game=<%= encodeURIComponent((categoryLabels && categoryLabels[cat]) || cat) %>"
     class="<%= gameFilter === ((categoryLabels && categoryLabels[cat]) || cat) ? 'active' : '' %>">
    <%= (categoryLabels && categoryLabels[cat]) || cat %>
  </a>
  <% }); %>
</div>

<% if (!accounts.length) { %>
<div class="akun-empty">
  <iconify-icon icon="mdi:account-search-outline" style="font-size:44px;display:block;margin:0 auto 12px;"></iconify-icon>
  <p style="font-size:13px;">Belum ada listing akun<% if (gameFilter) { %> untuk <%= gameFilter %><% } %> saat ini.</p>
</div>
<% } else { %>
<div class="akun-grid">
  <% accounts.forEach(function(a) { %>
  <a href="/jual-beli-akun/<%= a.id %>" class="akun-card">
    <div class="akun-card-img"><img src="<%= a.images?.[0] || '' %>" alt="<%= a.title %>" loading="lazy" onerror="this.style.opacity=0"></div>
    <div class="akun-card-body">
      <div class="akun-card-game"><%= a.game %></div>
      <div class="akun-card-title"><%= a.title %></div>
      <div class="akun-card-price">Rp <%= (a.price||0).toLocaleString('id-ID') %></div>
    </div>
  </a>
  <% }); %>
</div>
<% } %>

<a href="/jual-beli-akun-jual" class="akun-jual-fab">
  <iconify-icon icon="mdi:plus-circle" style="font-size:18px;"></iconify-icon> Jual Akun
</a>

<%- include('../partials/footer') %>

</body>
</html>
