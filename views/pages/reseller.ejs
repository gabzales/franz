<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reseller VIP — <%= settings?.siteName || 'FranzzStore' %></title>
  <meta name="description" content="Jadi Reseller VIP dan dapatkan diskon eksklusif untuk semua produk di <%= settings?.siteName || 'FranzzStore' %>.">
  <link rel="icon" type="image/png" href="<%= settings?.logoUrl || '/uploads/logo-main.png' %>">
  <link rel="stylesheet" href="/css/pointgo-theme.css">
  <script>
    window.IconifyPreload = <%- iconBundle %>;
  </script>
  <script src="/js/iconify-icon.min.js" defer></script>
</head>
<body>

<%- include('../partials/navbar', { active: 'home' }) %>

<div id="toast-wrap"></div>

<main class="inner-page">
  <div class="page-box" style="max-width:720px;">

    <!-- HERO -->
    <div style="text-align:center;margin-bottom:26px;">
      <div style="width:64px;height:64px;border-radius:16px;background:rgba(47,111,237,0.12);border:1px solid rgba(47,111,237,0.35);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
        <iconify-icon icon="mdi:crown" style="color:var(--accent);font-size:28px;"></iconify-icon>
      </div>
      <h1 style="color:var(--accent);">RESELLER VIP</h1>
      <p style="font-size:13.5px;color:var(--muted);line-height:1.6;max-width:420px;margin:14px auto 0;">
        <%= settings?.resellerNote || 'Dapatkan diskon eksklusif untuk semua produk dan jadilah mitra prioritas kami. Hanya dengan bayar sekali, nikmati benefit selamanya!' %>
      </p>
    </div>

    <% if (user && user.is_reseller) { %>
    <!-- ── SUDAH RESELLER ── -->
    <div style="background:var(--bg-soft);border:1px solid rgba(47,111,237,0.3);border-radius:var(--radius-lg);padding:28px 24px;text-align:center;">
      <iconify-icon icon="mdi:check-decagram" style="font-size:40px;color:var(--accent);display:block;margin:0 auto 12px;"></iconify-icon>
      <div style="font-size:16px;font-weight:800;color:var(--accent);margin-bottom:6px;">Kamu sudah Reseller VIP!</div>
      <p style="font-size:12.5px;color:var(--muted);margin-bottom:16px;line-height:1.6;">Diskon <strong style="color:var(--accent);">eksklusif reseller</strong> aktif otomatis di semua pembelian.</p>
      <% if (user.reseller_code) { %>
      <div style="display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:var(--radius-sm);background:rgba(47,111,237,0.12);border:1px solid rgba(47,111,237,0.35);font-family:monospace;font-size:14px;font-weight:800;color:var(--accent);margin-bottom:6px;">
        <iconify-icon icon="mdi:identifier" style="font-size:16px;"></iconify-icon>
        <%= user.reseller_code %>
      </div>
      <p style="font-size:10.5px;color:var(--muted);">Kode identitas reseller kamu</p>
      <% } %>
      <% if (settings?.resellerGroupUrl) { %>
      <a href="<%= settings.resellerGroupUrl %>" target="_blank" rel="noopener" class="pg-btn pg-btn-primary" style="margin-top:16px;text-decoration:none;background:var(--accent);">
        <iconify-icon icon="mdi:whatsapp" style="font-size:16px;"></iconify-icon> Gabung Grup <%= settings?.resellerGroupName || 'Reseller VIP' %>
      </a>
      <% } %>
      <a href="/" class="pg-btn pg-btn-outline" style="margin-top:10px;text-decoration:none;">
        <iconify-icon icon="mdi:shopping" style="font-size:15px;"></iconify-icon> Belanja Sekarang
      </a>
    </div>

    <% } else { %>
    <!-- ── BENEFIT LIST ── -->
    <div style="background:var(--bg-soft);border-radius:var(--radius-lg);padding:22px 20px;margin-bottom:16px;">
      <div style="font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px;">Keuntungan Bergabung</div>

      <div style="display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);">
        <div style="width:38px;height:38px;border-radius:9px;background:rgba(47,111,237,0.12);border:1px solid rgba(47,111,237,0.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <iconify-icon icon="mdi:tag-multiple" style="color:var(--accent);font-size:16px;"></iconify-icon>
        </div>
        <div>
          <div style="font-size:13.5px;font-weight:700;color:var(--text);">Diskon <span style="color:var(--accent);">Eksklusif</span> Otomatis Semua Produk</div>
          <div style="font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.5;">Harga reseller langsung terpotong tanpa perlu input kode apapun.</div>
        </div>
      </div>

      <div style="display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);">
        <div style="width:38px;height:38px;border-radius:9px;background:rgba(47,111,237,0.12);border:1px solid rgba(47,111,237,0.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <iconify-icon icon="mdi:lightning-bolt" style="color:var(--accent);font-size:16px;"></iconify-icon>
        </div>
        <div>
          <div style="font-size:13.5px;font-weight:700;color:var(--text);">Harga Langsung Terpotong di Checkout</div>
          <div style="font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.5;">Harga normal dicoret, harga reseller tampil di setiap pilihan paket.</div>
        </div>
      </div>

      <div style="display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);">
        <div style="width:38px;height:38px;border-radius:9px;background:rgba(47,111,237,0.12);border:1px solid rgba(47,111,237,0.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <iconify-icon icon="mdi:identifier" style="color:var(--accent);font-size:16px;"></iconify-icon>
        </div>
        <div>
          <div style="font-size:13.5px;font-weight:700;color:var(--text);">Kode Reseller Unik</div>
          <div style="font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.5;">Kode identitas reseller sebagai tanda keanggotaan VIP.</div>
        </div>
      </div>

      <div style="display:flex;align-items:flex-start;gap:12px;padding:12px 0;">
        <div style="width:38px;height:38px;border-radius:9px;background:rgba(47,111,237,0.12);border:1px solid rgba(47,111,237,0.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <iconify-icon icon="mdi:crown" style="color:var(--accent);font-size:16px;"></iconify-icon>
        </div>
        <div>
          <div style="font-size:13.5px;font-weight:700;color:var(--text);">Badge VIP di Profil</div>
          <div style="font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.5;">Status VIP tampil di badge profil dan halaman admin.</div>
        </div>
      </div>
    </div>

    <!-- ── HARGA & BAYAR ── -->
    <div style="background:var(--bg-soft);border:1px solid rgba(47,111,237,0.25);border-radius:var(--radius-lg);padding:26px 24px;">
      <div style="text-align:center;margin-bottom:20px;">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;">Biaya Keanggotaan Reseller VIP</div>
        <div style="font-size:38px;font-weight:900;color:var(--text);line-height:1;margin-bottom:6px;">
          Rp <%= (settings?.resellerPrice || 50000).toLocaleString('id-ID') %>
        </div>
        <div style="font-size:11.5px;color:var(--muted);">Bayar sekali · Diskon <strong style="color:var(--accent);">eksklusif</strong> berlaku selamanya</div>
      </div>

      <% if (!user) { %>
      <a href="/login?redirect=/reseller" class="pg-btn pg-btn-primary pg-btn-block" style="padding:13px;font-size:14px;text-decoration:none;">
        <iconify-icon icon="mdi:login" style="font-size:16px;"></iconify-icon> Login untuk Bergabung
      </a>
      <p style="font-size:11.5px;color:var(--muted);text-align:center;margin-top:12px;">Belum punya akun? <a href="/register" style="color:var(--accent);text-decoration:none;font-weight:700;">Daftar gratis</a></p>
      <% } else { %>
      <%
        const waNumber = (settings?.contact?.whatsapp || '').replace(/\D/g, '');
        const waMsg = encodeURIComponent(
          'Halo min, saya mau daftar Reseller VIP di ' + (settings?.siteName || 'FranzzStore') + '\n\n' +
          'Nama akun: ' + (user.username || '-') + '\n' +
          'Email: ' + (user.email || '-') + '\n\n' +
          'Mohon diproses ya, terima kasih!'
        );
      %>
      <a href="https://wa.me/<%= waNumber %>?text=<%= waMsg %>" target="_blank" rel="noopener"
         class="pg-btn pg-btn-primary pg-btn-block" style="padding:13px;font-size:14px;text-decoration:none;background:var(--accent);">
        <iconify-icon icon="mdi:whatsapp" style="font-size:20px;"></iconify-icon>
        Daftar via WhatsApp Admin
      </a>
      <p style="font-size:11.5px;color:var(--muted);text-align:center;margin-top:12px;line-height:1.6;">
        Kamu akan diarahkan ke WhatsApp admin untuk konfirmasi &amp; aktivasi reseller.
      </p>
      <% } %>
    </div>

    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>

<script>
function showToast(msg, type='info') {
    const wrap = document.getElementById('toast-wrap');
    const el = document.createElement('div');
    el.className = `toast-item toast-${type}`;
    el.textContent = msg;
    wrap.appendChild(el);
    setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 3500);
}
</script>
</body>
</html>
