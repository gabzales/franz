<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aktifkan Key</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/png" href="<%= settings?.logoUrl || '/uploads/logo-main.png' %>">
  <link rel="stylesheet" href="/css/pointgo-theme.css">
  <script>
    window.IconifyPreload = <%- iconBundle %>;
  </script>
  <script src="/js/iconify-icon.min.js" defer></script>
</head>
<body>

<%- include('../partials/navbar', { active: 'cek-pesanan' }) %>

<main class="inner-page">
  <div class="page-box" style="max-width:560px;">

    <div style="text-align:center;margin-bottom:24px;">
      <div style="width:64px;height:64px;border-radius:16px;background:rgba(47,111,237,0.12);border:1.5px solid rgba(47,111,237,0.35);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
        <iconify-icon icon="mdi:key-chain" style="color:var(--accent);font-size:30px;"></iconify-icon>
      </div>
      <h1 style="font-size:20px;color:var(--text);margin-bottom:6px;">Aktifkan Key</h1>
      <p style="font-size:12.5px;color:var(--muted);">Masukkan kode lisensi yang kamu miliki</p>
    </div>

    <!-- FORM -->
    <div style="background:var(--bg-soft);border-radius:var(--radius-lg);padding:24px 22px;margin-bottom:16px;">
      <form method="POST" action="/activate-key">
        <div class="pg-field">
          <label class="pg-field-label" for="code">Kode Lisensi</label>
          <div class="pg-input-wrap">
            <span class="pg-input-icon"><iconify-icon icon="mdi:key" style="color:var(--accent);"></iconify-icon></span>
            <input type="text" id="code" name="code" required
              value="<%= code || '' %>"
              class="pg-input" style="font-family:monospace;text-transform:uppercase;letter-spacing:.15em;text-align:center;font-weight:800;padding-left:14px;"
              placeholder="Contoh: KEY-A1B2C3"
              maxlength="30" autofocus
              oninput="this.value=this.value.toUpperCase()">
          </div>
          <p style="font-size:10.5px;color:var(--muted);margin-top:8px;text-align:center;line-height:1.5;">Format: <code style="color:var(--accent);">KODE - DURASI</code></p>
        </div>

        <% if (error) { %>
        <div class="pg-auth-error">
          <iconify-icon icon="mdi:alert-circle" style="flex-shrink:0;"></iconify-icon>
          <span><%= error %></span>
        </div>
        <% } %>

        <button type="submit" class="pg-btn pg-btn-primary pg-btn-block" style="padding:14px;font-size:14px;">
          <iconify-icon icon="mdi:lock-check" style="font-size:18px;"></iconify-icon> Aktifkan Sekarang
        </button>
      </form>
    </div>

    <!-- RESULT — muncul setelah aktivasi berhasil -->
    <% if (result) { %>
    <div class="pg-invoice-card" style="border:1.5px solid rgba(47,111,237,0.3);padding:0;overflow:hidden;">
      <div style="height:6px;background:var(--accent);"></div>
      <div style="padding:26px 22px;text-align:center;">
        <div style="width:48px;height:48px;border-radius:50%;background:rgba(47,111,237,0.15);border:2px solid rgba(47,111,237,0.4);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
          <iconify-icon icon="mdi:check-circle" style="color:var(--accent);font-size:24px;"></iconify-icon>
        </div>
        <div style="font-size:11px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px;">Aktivasi Berhasil!</div>
        <!-- Format KEY - DURASI -->
        <div style="font-weight:900;font-size:22px;color:var(--text);margin-bottom:6px;">
          <%= result.code %> — <%= result.duration %> Hari
        </div>
        <% if (result.label && result.label !== result.duration + ' Hari') { %>
        <div style="font-size:12px;color:var(--muted);margin-bottom:12px;"><%= result.label %></div>
        <% } %>
        <% if (result.note) { %>
        <div style="margin-top:12px;padding:12px;border-radius:var(--radius-sm);font-size:12px;color:var(--muted);background:var(--panel-soft);border:1px solid var(--line);display:flex;align-items:flex-start;gap:8px;text-align:left;">
          <iconify-icon icon="mdi:information" style="color:var(--accent);flex-shrink:0;margin-top:1px;"></iconify-icon>
          <span><%= result.note %></span>
        </div>
        <% } %>
        <div style="margin-top:14px;padding:12px;border-radius:var(--radius-sm);font-size:12px;color:var(--muted);background:var(--panel-soft);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;gap:6px;">
          <iconify-icon icon="mdi:clock-check" style="color:var(--accent);"></iconify-icon>
          Diaktifkan: <%= new Date().toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Info cara penggunaan -->
    <div style="background:var(--bg-soft);border-radius:var(--radius-lg);padding:20px;margin-top:16px;">
      <div style="font-size:12px;font-weight:700;color:var(--text);margin-bottom:14px;display:flex;align-items:center;gap:8px;">
        <iconify-icon icon="mdi:information-outline" style="color:var(--accent);"></iconify-icon> Cara Penggunaan
      </div>
      <div style="display:flex;flex-direction:column;gap:14px;">
        <div style="display:flex;align-items:flex-start;gap:10px;">
          <div style="width:20px;height:20px;border-radius:50%;background:var(--panel);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;color:var(--accent);flex-shrink:0;margin-top:1px;">1</div>
          <p style="font-size:12px;color:var(--muted);line-height:1.5;">Masukkan kode lisensi yang sudah kamu beli atau dapatkan dari admin</p>
        </div>
        <div style="display:flex;align-items:flex-start;gap:10px;">
          <div style="width:20px;height:20px;border-radius:50%;background:var(--panel);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;color:var(--accent);flex-shrink:0;margin-top:1px;">2</div>
          <p style="font-size:12px;color:var(--muted);line-height:1.5;">Sistem akan memvalidasi key dan menampilkan durasi akses</p>
        </div>
        <div style="display:flex;align-items:flex-start;gap:10px;">
          <div style="width:20px;height:20px;border-radius:50%;background:var(--panel);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;color:var(--accent);flex-shrink:0;margin-top:1px;">3</div>
          <p style="font-size:12px;color:var(--muted);line-height:1.5;">Satu key hanya bisa digunakan satu kali. Simpan bukti aktivasi kamu</p>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>

</body>
</html>
